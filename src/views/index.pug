doctype html
html
  head
    meta(charset="utf-8")
    title Propusnice
  body
    h1 Propusnice
    p Ukupno propusnica: #{total}
    p Aktivnih propusnica: #{active}

    if user
      p Prijavljeni ste kao #{user}
      form(method="post" action="/logout")
        button(type="submit") Odjava
    else
      a(href="/login") Prijava
